{{- $posts := slice -}}
{{- range (where site.RegularPages "Section" "posts").ByDate.Reverse -}}
{{- $posts = $posts | append (dict "title" .Title "date" (.Date.Format "2006 年 1 月 2 日") "summary" (.Description | default (.Summary | plainify)) "content" .Plain "tags" (.Params.tags | default slice) "url" .RelPermalink) -}}
{{- end -}}
{{- $posts | jsonify -}}
